# Production settings for EmpowerHer. Copy the values you need into .env.
# Keep your EXISTING encryption keys: new keys cannot read existing data.

DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=empowerher.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://empowerher.example.org
DJANGO_CORS_ALLOWED_ORIGINS=https://empowerher.example.org

# PostgreSQL (recommended for production). Leave unset to use SQLite.
DATABASE_URL=postgres://empowerher:change-me@localhost:5432/empowerher

# Set to True when a reverse proxy (nginx, Caddy, Render, Railway...) handles HTTPS.
DJANGO_BEHIND_PROXY=True
# HTTPS settings (leave as True in production).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_HSTS_SECONDS=31536000

# Login sessions expire after this many hours (default 7 days).
DJANGO_TOKEN_TTL_HOURS=168
# Rate limits for login/registration and public proof verification.
DJANGO_AUTH_RATE=10/minute
DJANGO_PUBLIC_RATE=60/minute
# AI assistant / idea validation, and document uploads (OCR).
DJANGO_AI_RATE=20/minute
DJANGO_UPLOAD_RATE=10/minute
# Overall limits per visitor IP and per logged-in user.
DJANGO_ANON_RATE=120/minute
DJANGO_USER_RATE=600/minute

IDEA_VAULT_ENCRYPTION_KEY=keep-your-existing-key
DOCUMENT_ENCRYPTION_KEY=keep-your-existing-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
